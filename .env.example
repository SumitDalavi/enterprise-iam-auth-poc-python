# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: enterprise-iam-auth-poc-python
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-memory SQLite user store and development secret key.
#
# TIER 2 / TIER 3: PRODUCTION OIDC / REDIS SESSIONS
# - Provide Redis and database connection strings.

SECRET_KEY=dev-secret-key-change-in-production
DATABASE_URL=sqlite:///./iam.db
REDIS_URL=
SESSION_TTL_SECONDS=3600
PORT=8000
